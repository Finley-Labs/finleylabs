<script>
  // Technical orbital network animation
  const initCanvas = () => {
    const canvas = document.getElementById('hero-canvas') as HTMLCanvasElement;
    if (!canvas) return;
    
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    let width = canvas.width = canvas.offsetWidth;
    let height = canvas.height = canvas.offsetHeight;
    
    let animationId: number;

    const handleResize = () => {
      width = canvas.width = canvas.offsetWidth;
      height = canvas.height = canvas.offsetHeight;
    };

    window.addEventListener('resize', handleResize);

    const particles: Array<{
      x: number;
      y: number;
      vx: number;
      vy: number;
      radius: number;
      color: string;
    }> = [];
    
    const particleCount = 45;

    for (let i = 0; i < particleCount; i++) {
      particles.push({
        x: Math.random() * width,
        y: Math.random() * height,
        vx: (Math.random() - 0.5) * 0.25,
        vy: (Math.random() - 0.5) * 0.25,
        radius: Math.random() * 2 + 1.2,
        color: Math.random() > 0.55 ? '#2563FF' : '#7C3AED'
      });
    }

    const reducedMotionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');

    const animate = () => {
      ctx.clearRect(0, 0, width, height);

      // Draw connections
      for (let i = 0; i < particleCount; i++) {
        for (let j = i + 1; j < particleCount; j++) {
          const dx = particles[i].x - particles[j].x;
          const dy = particles[i].y - particles[j].y;
          const dist = Math.hypot(dx, dy);

          if (dist < 125) {
            ctx.beginPath();
            ctx.moveTo(particles[i].x, particles[i].y);
            ctx.lineTo(particles[j].x, particles[j].y);
            // Draw fade gradient lines based on distance
            const alpha = 0.08 * (1 - dist / 125);
            ctx.strokeStyle = `rgba(37, 99, 255, ${alpha})`;
            ctx.lineWidth = 0.8;
            ctx.stroke();
          }
        }
      }

      // Move & Draw particles
      particles.forEach(p => {
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
        ctx.fillStyle = p.color;
        ctx.globalAlpha = 0.6;
        ctx.fill();
        ctx.globalAlpha = 1;

        if (!reducedMotionQuery.matches) {
          p.x += p.vx;
          p.y += p.vy;

          // Wrap edges instead of bounce for softer transition
          if (p.x < 0) p.x = width;
          if (p.x > width) p.x = 0;
          if (p.y < 0) p.y = height;
          if (p.y > height) p.y = 0;
        }
      });

      if (!reducedMotionQuery.matches) {
        animationId = requestAnimationFrame(animate);
      }
    };

    if (!reducedMotionQuery.matches) {
      animate();
    }

    reducedMotionQuery.addEventListener('change', (e) => {
      if (e.matches) {
        cancelAnimationFrame(animationId);
        ctx.clearRect(0, 0, width, height);
      } else {
        animate();
      }
    });
  };

  // Run on page load
  initCanvas();
</script>
