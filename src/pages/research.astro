---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import { ArrowRight, BookOpen } from '@lucide/astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL;

const allResearch = await getCollection('research');
const articles = allResearch.map(article => ({
  category: article.data.category,
  title: article.data.title,
  description: article.data.description,
  date: article.data.date,
  readTime: article.data.readTime,
  href: `${base}research`
}));
---

<BaseLayout
  title="Research & Insights — Finley Labs"
  description="Read engineering write-ups, technical articles, and system tutorials written by the researchers at Finley Labs."
>
  <!-- Research Hero -->
  <section class="research-hero section-padding">
    <div class="container text-center">
      <div class="journal-badge">
        <BookOpen size={14} />
        <span>ENGINEERING JOURNAL</span>
      </div>
      <h1 class="hero-title">Research & <span class="gradient-text">Insights.</span></h1>
      <p class="hero-desc">
        Deep dives, tutorials, and field notes detailing the architectural decisions, tools, and technical experiments we conduct daily.
      </p>
    </div>
  </section>

  <!-- Articles List -->
  <section class="articles-list-section" aria-label="Research papers and logs">
    <div class="container">
      <div class="articles-stack">
        {articles.map(article => (
          <article class="article-item">
            <div class="article-meta-row">
              <span class="article-category">{article.category}</span>
              <span class="article-details">{article.date} &middot; {article.readTime}</span>
            </div>
            
            <h2 class="article-title">
              <a href={article.href}>{article.title}</a>
            </h2>
            
            <p class="article-summary">{article.description}</p>
            
            <div class="article-footer">
              <span class="placeholder-label">[ RESEARCH PLACEHOLDER ]</span>
              <a href={article.href} class="article-link">
                Read Article <ArrowRight size={16} />
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Newsletter Signup -->
  <section class="newsletter-section section-padding">
    <div class="container">
      <div class="newsletter-card">
        <h2 class="newsletter-title">Subscribe to the Finley Journal</h2>
        <p class="newsletter-sub">Get our latest engineering notes and emerging technology studies delivered to your inbox monthly.</p>
        
        <form class="newsletter-form" onsubmit="event.preventDefault(); alert('Subscribed (demo)');">
          <input type="email" placeholder="Enter your email address" required class="newsletter-input" />
          <Button type="submit" variant="primary">Subscribe</Button>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .research-hero {
    background-color: var(--color-black);
  }

  .text-center {
    text-align: center;
  }

  .journal-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background-color: rgba(37, 99, 255, 0.08);
    border: 1px solid rgba(37, 99, 255, 0.15);
    padding: 6px 14px;
    border-radius: 100px;
    font-size: 0.8rem;
    font-family: var(--font-headings);
    font-weight: 600;
    color: var(--color-blue);
    margin-bottom: 24px;
    letter-spacing: 0.05em;
  }

  .hero-title {
    margin-bottom: 24px;
  }

  .hero-desc {
    max-width: 660px;
    margin: 0 auto;
    font-size: clamp(1.1rem, 2vw, 1.25rem);
    color: var(--color-text-secondary);
  }

  /* Articles Stack */
  .articles-list-section {
    padding-bottom: clamp(60px, 10vw, 120px);
  }

  .articles-stack {
    display: flex;
    flex-direction: column;
    gap: 24px;
    max-width: 860px;
    margin: 0 auto;
  }

  .article-item {
    background-color: var(--color-navy);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: clamp(24px, 4vw, 40px);
    transition: border-color var(--transition-fast);
  }

  .article-item:hover {
    border-color: rgba(255, 255, 255, 0.15);
  }

  .article-meta-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
    font-size: 0.8rem;
  }

  .article-category {
    font-weight: 700;
    color: var(--color-blue);
    letter-spacing: 0.05em;
  }

  .article-details {
    color: var(--color-text-muted);
  }

  .article-title {
    font-size: clamp(1.4rem, 2.5vw, 1.8rem);
    margin-bottom: 12px;
    line-height: 1.3;
  }

  .article-title a:hover {
    color: var(--color-blue);
    background: var(--gradient-finley);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .article-summary {
    font-size: 1rem;
    color: var(--color-text-secondary);
    margin-bottom: 24px;
    line-height: 1.6;
  }

  .article-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid rgba(255, 255, 255, 0.04);
    padding-top: 20px;
  }

  .placeholder-label {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    font-family: var(--font-headings);
  }

  .article-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 600;
    color: var(--color-white);
    font-size: 0.9rem;
  }

  .article-link svg {
    transition: transform var(--transition-fast);
  }

  .article-link:hover svg {
    transform: translateX(4px);
  }

  /* Newsletter Box */
  .newsletter-card {
    background: radial-gradient(circle at top right, rgba(37, 99, 255, 0.08), transparent 45%),
                var(--color-navy);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: clamp(32px, 6vw, 60px) 24px;
    text-align: center;
    max-width: 860px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .newsletter-title {
    margin-bottom: 12px;
  }

  .newsletter-sub {
    font-size: 1.05rem;
    color: var(--color-text-secondary);
    margin-bottom: 32px;
    max-width: 500px;
  }

  .newsletter-form {
    display: flex;
    flex-direction: column;
    gap: 12px;
    width: 100%;
    max-width: 500px;
  }

  @media (min-width: 576px) {
    .newsletter-form {
      flex-direction: row;
      background-color: rgba(255, 255, 255, 0.02);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-sm);
      padding: 6px;
      gap: 0;
    }
  }

  .newsletter-input {
    background-color: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--color-border);
    color: var(--color-white);
    padding: 12px 20px;
    border-radius: var(--radius-sm);
    font-family: var(--font-body);
    font-size: 0.95rem;
    flex-grow: 1;
  }

  @media (min-width: 576px) {
    .newsletter-input {
      background-color: transparent;
      border: none;
    }
    
    .newsletter-input:focus {
      outline: none;
    }
  }
</style>
