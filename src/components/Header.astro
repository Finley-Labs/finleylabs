---
import { ArrowRight, Menu, X } from '@lucide/astro';

const base = import.meta.env.BASE_URL;

const navItems = [
  { name: 'Solutions', href: `${base}solutions` },
  { name: 'Projects', href: `${base}projects` },
  { name: 'Lab', href: `${base}lab` },
  { name: 'Research', href: `${base}research` },
  { name: 'About', href: `${base}about` },
];
---

<header class="header">
  <div class="container header-container">
    <a href={base} class="logo-link">
      <img src={`${base}brand/logo-monogram.png`} alt="Finley Labs Monogram" class="logo-img" />
      <span class="logo-text">FINLEY LABS</span>
    </a>

    <nav class="desktop-nav" aria-label="Desktop navigation">
      <ul class="nav-list">
        {navItems.map(item => (
          <li>
            <a href={item.href} class="nav-link">{item.name}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="cta-container">
      <a href={`${base}contact`} class="cta-button">
        Start a Project <ArrowRight size={16} class="arrow-icon" />
      </a>
      
      <button class="hamburger-btn" aria-label="Toggle menu" aria-expanded="false" aria-controls="mobile-menu">
        <Menu size={24} class="menu-icon" />
        <X size={24} class="close-icon" />
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="mobile-menu" aria-hidden="true">
    <nav class="mobile-nav" aria-label="Mobile navigation">
      <ul class="mobile-nav-list">
        <li><a href={base} class="mobile-nav-link">Home</a></li>
        {navItems.map(item => (
          <li>
            <a href={item.href} class="mobile-nav-link">{item.name}</a>
          </li>
        ))}
        <li><a href={`${base}contact`} class="mobile-nav-link">Contact</a></li>
        <li class="mobile-cta-li">
          <a href={`${base}contact`} class="mobile-cta-button">
            Start a Project <ArrowRight size={16} />
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    background-color: transparent;
    border-bottom: 1px solid transparent;
    transition: background-color var(--transition-normal), border-bottom var(--transition-normal), padding var(--transition-normal);
    padding: 24px 0;
  }

  .header.scrolled {
    background-color: rgba(11, 15, 25, 0.85);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--color-border);
    padding: 14px 0;
  }

  .header-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .logo-link {
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-headings);
    font-weight: 700;
    font-size: 1.15rem;
    letter-spacing: 0.05em;
    color: var(--color-white);
  }

  .logo-img {
    height: 32px;
    width: auto;
    object-fit: contain;
    border-radius: var(--radius-sm);
  }

  .logo-text {
    background: var(--gradient-text);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .desktop-nav {
    display: none;
  }

  .nav-list {
    display: flex;
    gap: 32px;
    list-style: none;
  }

  .nav-link {
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--color-text-secondary);
    transition: color var(--transition-fast);
    padding: 8px 0;
    position: relative;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--gradient-finley);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform var(--transition-fast);
  }

  .nav-link:hover {
    color: var(--color-white);
  }

  .nav-link:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .cta-container {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .cta-button {
    display: none;
    align-items: center;
    gap: 8px;
    background-color: var(--color-blue);
    color: var(--color-white);
    padding: 10px 20px;
    border-radius: var(--radius-sm);
    font-weight: 600;
    font-size: 0.9rem;
    transition: background var(--transition-fast), transform var(--transition-fast);
    border: none;
    cursor: pointer;
  }

  .cta-button:hover {
    background: var(--gradient-finley);
    transform: translateY(-1px);
  }

  .arrow-icon {
    transition: transform var(--transition-fast);
  }

  .cta-button:hover .arrow-icon {
    transform: translateX(4px);
  }

  .hamburger-btn {
    background: none;
    border: none;
    color: var(--color-white);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 8px;
    border-radius: var(--radius-sm);
    border: 1px solid rgba(255, 255, 255, 0.05);
    background: rgba(255, 255, 255, 0.02);
  }

  .close-icon {
    display: none;
  }

  .hamburger-btn.active .menu-icon {
    display: none;
  }

  .hamburger-btn.active .close-icon {
    display: block;
  }

  /* Mobile menu styles */
  .mobile-menu {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(11, 15, 25, 0.98);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    z-index: 40;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    transition: opacity var(--transition-normal), visibility var(--transition-normal);
  }

  .mobile-menu.active {
    opacity: 1;
    visibility: visible;
  }

  .mobile-nav-list {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
    list-style: none;
    text-align: center;
  }

  .mobile-nav-link {
    font-size: 1.5rem;
    font-family: var(--font-headings);
    font-weight: 600;
    color: var(--color-text-secondary);
  }

  .mobile-nav-link:hover {
    color: var(--color-white);
  }

  .mobile-cta-li {
    margin-top: 16px;
  }

  .mobile-cta-button {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--gradient-finley);
    color: var(--color-white);
    padding: 12px 28px;
    border-radius: var(--radius-sm);
    font-weight: 600;
    font-size: 1rem;
  }

  @media (min-width: 768px) {
    .desktop-nav {
      display: block;
    }

    .cta-button {
      display: inline-flex;
    }

    .hamburger-btn {
      display: none;
    }

    .mobile-menu {
      display: none;
    }
  }
</style>

<script>
  // Handle header background scroll transition
  const header = document.querySelector('.header');
  const checkScroll = () => {
    if (window.scrollY > 40) {
      header?.classList.add('scrolled');
    } else {
      header?.classList.remove('scrolled');
    }
  };
  
  window.addEventListener('scroll', checkScroll);
  // Initial check on load
  checkScroll();

  // Mobile menu toggle logic
  const burger = document.querySelector('.hamburger-btn');
  const menu = document.querySelector('.mobile-menu');

  if (burger && menu) {
    burger.addEventListener('click', () => {
      const active = burger.classList.toggle('active');
      menu.classList.toggle('active');
      burger.setAttribute('aria-expanded', active ? 'true' : 'false');
      menu.setAttribute('aria-hidden', active ? 'false' : 'true');
      
      // Toggle body scrolling
      if (active) {
        document.body.style.overflow = 'hidden';
      } else {
        document.body.style.overflow = '';
      }
    });

    // Close menu when clicking navigation links
    const mobileLinks = menu.querySelectorAll('.mobile-nav-link');
    mobileLinks.forEach(link => {
      link.addEventListener('click', () => {
        burger.classList.remove('active');
        menu.classList.remove('active');
        burger.setAttribute('aria-expanded', 'false');
        menu.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
      });
    });
  }
</script>
